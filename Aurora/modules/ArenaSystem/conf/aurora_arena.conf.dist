# ============================================================================
# ArenaSystem module configuration
#
# Loaded by worldserver from configs/modules/aurora_arena.conf after worldserver.conf.
# Options are read by the module in WorldScript::OnStartup, so a change needs a
# restart (or `.reload config` followed by a re-login where the module says so).
# ============================================================================

#    Aurora.Arena.Enabled
#        Enable the Aurora arena helpers (.arena queue, .arena rank, .arena stats).
#        Default:     1

Aurora.Arena.Enabled = 1

#    Aurora.Arena.RatedMinimumLevel
#        Level a character needs before .arena queue reports it as rated-arena
#        eligible. Range 1-80.
#        Default:     80

Aurora.Arena.RatedMinimumLevel = 80
