# ============================================================================
# Economy module configuration
#
# Loaded by worldserver from configs/modules/aurora_economy.conf after worldserver.conf.
# Options are read by the module in WorldScript::OnStartup, so a change needs a
# restart (or `.reload config` followed by a re-login where the module says so).
# ============================================================================

#    Aurora.Economy.Enabled
#        Enable the Aurora economy helpers (.economy commands).
#        Default:     1

Aurora.Economy.Enabled = 1

#    Aurora.Economy.AuctionDepositPercent
#        Percent of a bid that the Aurora auction helper reports as deposit.
#        Range 0-100.
#        Default:     5

Aurora.Economy.AuctionDepositPercent = 5
